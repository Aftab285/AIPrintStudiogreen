---
import Layout from "../layouts/Layout.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import QuoteForm from "../components/QuoteForm.astro";

const whatsappUrl =
  "https://wa.me/923479429415?text=" +
  encodeURIComponent(
    "Hello! I created artwork using AI and need it professionally recreated into a commercial print-ready file. Can we discuss my project?"
  );
---

<Layout
  title="Contact Us & Get a Free Pre-Press Quote | AIPrintStudio"
  description="Get a free quote for your AI artwork print preparation. Direct WhatsApp chat (+92 347 9429415), direct email (haftab285@gmail.com) or submit our consultation form. Average response time: 15 minutes."
>
  <AnnouncementBar />
  <Navbar activePath="/contact" />
  <main class="subpage-main">
    <div class="subpage-hero">
      <div class="container">
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />
        <h1 class="subpage-hero__title">
          Let&apos;s Discuss Your <span class="highlight-text">AI Print Project</span>
        </h1>
        <p class="subpage-hero__subtitle">
          We operate on personal consultation. Contact us on WhatsApp or Email for immediate feedback, or submit your project details below for a fast, free quote.
        </p>
      </div>
    </div>

    <section class="container py-8">
      <div class="contact-grid">
        <div class="contact-form-col">
          <QuoteForm />
        </div>

        <div class="contact-info-col">
          {/* Direct WhatsApp Card */}
          <div class="contact-direct-card">
            <div class="contact-direct-card__icon contact-direct-card__icon--whatsapp" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
              </svg>
            </div>
            <h3>Instant WhatsApp Support</h3>
            <p>Chat directly with our pre-press lead on WhatsApp. Send sample images and get real-time technical answers.</p>
            <div class="contact-phone-number">+92 347 9429415</div>
            <a
              href={whatsappUrl}
              class="btn btn--primary btn--full"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Send your artwork files and details to our pre-press team on WhatsApp"
            >
              Message on WhatsApp Now →
            </a>
          </div>

          {/* Direct Email Card */}
          <div class="contact-direct-card contact-direct-card--email mt-6">
            <div class="contact-direct-card__icon contact-direct-card__icon--email" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <h3>Direct Email Inquiries</h3>
            <p>Prefer email? Send your project brief, specifications, and files directly to our inbox.</p>
            <div class="contact-phone-number" style="font-size: 1.125rem;">haftab285@gmail.com</div>
            <a
              href="mailto:haftab285@gmail.com?subject=AI%20Artwork%20Print%20Preparation%20Inquiry"
              class="btn btn--outline btn--full"
              aria-label="Send direct project inquiry email to haftab285@gmail.com"
            >
              Send Email Inquiry →
            </a>
          </div>

          <div class="contact-details-box mt-6">
            <h4>Customer Service Hours &amp; Response</h4>
            <p><strong>Response Time:</strong> Typically within 15–30 minutes</p>
            <p><strong>Availability:</strong> 24/7 Global Client Support</p>
            <p><strong>Supported Regions:</strong> USA, Canada, United Kingdom, Australia, Europe &amp; Worldwide</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
