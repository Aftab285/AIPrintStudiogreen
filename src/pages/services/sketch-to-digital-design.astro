            </div>
          </div>
          <aside class="service-sidebar">
            <QuoteForm defaultService="Sketch to Digital Design" />

            <div class="sidebar-contact-card">
              <h4>Need Immediate Help?</h4>
              <p>Send your sketch directly on WhatsApp for instant feedback on your concept.</p>
              <a
                href={whatsappUrl}
                class="btn btn--primary btn--full"
                target="_blank"
                rel="noopener noreferrer"
              >
                WhatsApp +92 347 9429415
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
