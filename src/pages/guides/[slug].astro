---
import Layout from "../../layouts/Layout.astro";
import AnnouncementBar from "../../components/AnnouncementBar.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import CTABanner from "../../components/CTABanner.astro";
import { toolsData } from "../../data/toolsData.js";

export async function getStaticPaths() {
  return Object.keys(toolsData).map((slug) => ({
    params: { slug },
    props: { tool: toolsData[slug] },
  }));
}

const { tool } = Astro.props;

const metaTitle = `How to Print ${tool.name} Artwork — Commercial Print Guide | AIPrintStudio`;
const metaDescription = `Learn how to prepare ${tool.name} AI images for commercial printing. Convert ${tool.nativeRes} screen files into 300+ DPI or vector files with CMYK color management.`;

const whatsappUrl =
  "https://wa.me/923479429415?text=" +
  encodeURIComponent(
    `Hello! I generated artwork using ${tool.name} and need it professionally prepared for commercial printing. Can we discuss?`
  );
---

<Layout
  title={metaTitle}
  description={metaDescription}
  canonical={`https://aiprintstudio.com/guides/${tool.slug}`}
>
  <AnnouncementBar />
  <Navbar activePath="/guides" />
  <main class="subpage-main guide-detail-page">
    <div class="subpage-hero">
      <div class="container">
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: "AI Guides", href: "/guides" },
            { label: tool.name },
          ]}
        />
        <div class="service-detail-hero">
          <div class="service-detail-hero__content">
            <span class="section-badge">Tool Printing Guide</span>
            <h1 class="subpage-hero__title">{tool.heroHeading}</h1>
            <p class="subpage-hero__subtitle">{tool.tagline}</p>
            
            <div class="service-detail-meta-pills">
              <span class="meta-pill">Native Output: <strong>{tool.nativeRes}</strong></span>
              <span class="meta-pill text-warning">Native DPI: <strong>{tool.startingDpi}</strong></span>
              <span class="meta-pill text-success">Commercial Target: <strong>{tool.targetRes}</strong></span>
            </div>

            <div class="service-detail-actions">
              <a
                href={whatsappUrl}
                class="btn btn--primary btn--large"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Chat directly on WhatsApp to prepare ${tool.name} artwork`}
              >
                Prepare My {tool.name} Art →
              </a>
              <a href="#quote" class="btn btn--outline btn--large" aria-label={`Request a free quote for ${tool.name} artwork preparation`}>
                Get a Free Quote
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="container py-8">
      <div class="service-content-grid">
        <div class="service-main-content">
          <div class="content-card">
            <h2 class="content-card__title">Printing Challenges for {tool.name}</h2>
            <p class="content-card__body">{tool.description}</p>
          </div>

          <div class="takeaways-box">
            <h3 class="takeaways-box__title">📌 Summary &amp; Print Targets</h3>
            <ul class="takeaways-box__list">
              <li>✓ Native resolution ({tool.nativeRes} at {tool.startingDpi}) must be converted to {tool.targetRes}.</li>
              <li>✓ Screen sRGB colors must be mapped to physical CMYK press profiles.</li>
              <li>✓ 0.125” safety bleeds and vector cut paths must be established.</li>
            </ul>
          </div>

          <div class="content-card">
            <h2 class="content-card__title">Common Print Issues with Raw {tool.name} Files</h2>
            <div class="issues-list">
              {tool.commonIssues?.map((issue: string) => (
                <div class="issue-item">
                  <h4 class="issue-item__title">✕ Common Issue</h4>
                  <p class="issue-item__desc">{issue}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="content-card">
            <h2 class="content-card__title">Our Professional Reproduction Workflow</h2>
            <div class="issues-list">
              {tool.recreationWorkflow?.map((step: string) => (
                <div class="issue-item">
                  <h4 class="issue-item__title text-success">✓ Standard Step</h4>
                  <p class="issue-item__desc">{step}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <aside class="service-sidebar" id="quote">
          <QuoteForm defaultService="AI Artwork Recreation" />
          
          <div class="sidebar-contact-card">
            <h4>Need Quick Feedback?</h4>
            <p>Send your raw {tool.name} image directly via WhatsApp for a free 15-minute file inspection.</p>
            <a
              href={whatsappUrl}
              class="btn btn--primary btn--full"
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp +92 347 9429415
            </a>
          </div>
        </aside>
      </div>
    </section>

    <CTABanner />
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
