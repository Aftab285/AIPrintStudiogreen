---
const steps = [
  {
    num: "01",
    title: "Connect & Send Your AI Artwork",
    desc: "Connect directly via WhatsApp or our free quote form. Share your AI generation and tell us what you are printing (apparel, poster, packaging, logo, book cover).",
    highlight: "Personal Consultation",
  },
  {
    num: "02",
    title: "Free Pre-Press Inspection",
    desc: "We examine your file's resolution, artifacts, colors, and margins. We provide transparent advice and a custom quote with a guaranteed delivery time.",
    highlight: "No Obligation Review",
  },
  {
    num: "03",
    title: "100% Manual Redraw & Color Prep",
    desc: "Our graphic reproduction specialists manually redraw vector paths, replace wavy AI text with real fonts, optimize CMYK profiles, and set up 0.125” bleeds.",
    highlight: "Zero Hallucinated AI Bloat",
  },
  {
    num: "04",
    title: "Commercial Print-Ready Delivery",
    desc: "Receive a complete master package (.AI, .EPS, .PDF/X, .PNG, .TIFF). We guarantee 100% acceptance by your commercial printer or print-on-demand platform.",
    highlight: "100% Print Shop Guarantee",
  },
];

const whatsappUrl =
  "https://wa.me/923479429415?text=" +
  encodeURIComponent(
    "Hello! I created artwork using AI and need it professionally recreated into a commercial print-ready file. Can we discuss my project?"
  );
---

<section class="how-it-works-section" id="how-it-works" aria-labelledby="how-it-works-heading">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge">Simple 4-Step Process</span>
      <h2 class="section-title" id="how-it-works-heading">
        How We Transform Your AI Art into <span class="highlight-text">Print-Ready Perfection</span>
      </h2>
      <p class="section-subtitle">
        A consultation-first workflow designed to give you direct access to professional pre-press artists without robotic automated upload forms.
      </p>
    </div>

    <div class="steps-grid">
      {steps.map((step) => (
        <div class="step-card">
          <div class="step-card__top">
            <span class="step-card__num">{step.num}</span>
            <span class="step-card__highlight">{step.highlight}</span>
          </div>
          <h3 class="step-card__title">{step.title}</h3>
          <p class="step-card__desc">{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="how-it-works-cta text-center">
      <a
        href={whatsappUrl}
        class="btn btn--primary btn--large"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Start your AI artwork reproduction project on WhatsApp with our lead specialist"
      >
        Start Your AI Artwork Project on WhatsApp →
      </a>
      <span class="how-it-works-cta__sub">Free Pre-Press File Inspection · Fast 12–24h Turnaround</span>
    </div>
  </div>
</section>
