---
const problems = [
  {
    tag: "Resolution Trap",
    title: "72 DPI Screen Pixels vs 300 DPI Print",
    desc: "AI generators output 1024px images designed for backlit screens. When printed on an 18x24\" poster or canvas, that drops to an unreadable 56 DPI, causing visible pixelation and jagged edges.",
  },
  {
    tag: "Color Degradation",
    title: "RGB Light vs CMYK Physical Ink",
    desc: "AI artwork renders in vibrant glowing RGB light. Commercial presses use CMYK ink. Without manual color mapping, electric greens, cyans, and purples turn into muddy, dark olive and grey.",
  },
  {
    tag: "Illegible Text",
    title: "Melted, Wavy AI Typography",
    desc: "Generative AI engines hallucinate fake letters, crooked baselines, and garbled words. Logos, book covers, and business cards require real vector fonts with exact kerning.",
  },
  {
    tag: "Preflight Failure",
    title: "Zero Bleeds & Missing Cut Paths",
    desc: "Printing and vinyl cutting machinery require 0.125” safety bleeds and 100% vector contour paths. Raw AI images lack both, causing 95% of print shops to reject files outright.",
  },
];
---

<section class="problem-section" id="why-ai-fails" aria-labelledby="problem-heading">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge">The Commercial Reality</span>
      <h2 class="section-title" id="problem-heading">
        Why Raw AI Images <span class="highlight-text">Fail at Print Shops</span>
      </h2>
      <p class="section-subtitle">
        AI image generators create beautiful digital artwork, but they are built for screens—not commercial printing presses. Here is why raw AI files fail:
      </p>
    </div>

    <div class="problem-grid">
      {problems.map((p, idx) => (
        <div class="problem-card">
          <div class="problem-card__icon">
            {idx === 0 && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            )}
            {idx === 1 && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
              </svg>
            )}
            {idx === 2 && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4 7 4 4 20 4 20 7"></polyline>
                <line x1="9" y1="20" x2="15" y2="20"></line>
                <line x1="12" y1="4" x2="12" y2="20"></line>
              </svg>
            )}
            {idx === 3 && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="21"></line>
              </svg>
            )}
          </div>
          <span class="problem-card__tag">{p.tag}</span>
          <h3 class="problem-card__title">{p.title}</h3>
          <p class="problem-card__desc">{p.desc}</p>
        </div>
      ))}
    </div>

    <div class="solution-callout">
      <div class="solution-callout__badge">The AIPrintStudio Solution</div>
      <p class="solution-callout__text">
        <strong>We do not rely on automated AI upscalers that hallucinate artifacts.</strong> Every project is manually reconstructed, vector-traced, and color-separated by seasoned pre-press production artists for guaranteed commercial press approval.
      </p>
      <a href="/how-it-works" class="btn btn--outline btn--sm" aria-label="Learn our 4-step human pre-press technical reproduction process">
        Learn Our 4-Step Technical Process →
      </a>
    </div>
  </div>
</section>
