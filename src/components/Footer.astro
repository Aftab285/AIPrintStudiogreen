---
import { servicesData } from "../data/servicesData.js";
import { toolsData } from "../data/toolsData.js";

const servicesList = Object.values(servicesData);
const toolsList = Object.values(toolsData);
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      {/* Brand Info */}
      <div class="footer-col footer-col--brand">
        <a href="/" class="footer-brand">
          <picture>
            <source srcset="/logo.webp" type="image/webp" />
            <img
              src="/logo.jpg"
              alt="AIPrintStudio Logo"
              width="36"
              height="36"
              class="footer-logo"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <span class="footer-brand-name">AIPrintStudio</span>
        </a>
        <p class="footer-tagline">
          The internet&apos;s leading authority for transforming AI-generated artwork into professional, commercial print-ready files.
        </p>
        <div class="footer-contact-item">
          <span>Direct Email:</span>
          <a
            href="mailto:contact@aiprintstudio.com"
            class="footer-link text-success"
            aria-label="Send direct email to contact@aiprintstudio.com"
          >
            contact@aiprintstudio.com
          </a>
        </div>
        <div class="footer-contact-item">
          <span>Direct WhatsApp:</span>
          <a
            href="https://wa.me/923479429415?text=Hello!%20I%20have%20an%20AI%20artwork%20print%20project."
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link text-success"
            aria-label="Chat directly on WhatsApp with AIPrintStudio at +92 347 9429415"
          >
            +92 347 9429415
          </a>
        </div>
        <div class="footer-contact-item">
          <span>Primary Markets:</span>
          <span>United States, Canada, UK, Australia, Europe</span>
        </div>
      </div>

      {/* Services Links */}
      <div class="footer-col">
        <h4 class="footer-title">Pre-Press Services</h4>
        <ul class="footer-links">
          {servicesList.slice(0, 7).map((srv) => (
            <li>
              <a href={`/services/${srv.slug}`} class="footer-link">
                {srv.shortTitle}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-title">Specialty Print Setup</h4>
        <ul class="footer-links">
          {servicesList.slice(7).map((srv) => (
            <li>
              <a href={`/services/${srv.slug}`} class="footer-link">
                {srv.shortTitle}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* AI Guides */}
      <div class="footer-col">
        <h4 class="footer-title">AI Tool Guides</h4>
        <ul class="footer-links">
          {toolsList.map((tool) => (
            <li>
              <a href={`/guides/${tool.slug}`} class="footer-link">
                Print from {tool.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/blog" class="footer-link" aria-label="Explore all pre-press and printing knowledge hub articles">
              <strong>Explore Knowledge Hub Articles →</strong>
            </a>
          </li>
        </ul>
      </div>

      {/* Quick Links & Legal */}
      <div class="footer-col">
        <h4 class="footer-title">Company</h4>
        <ul class="footer-links">
          <li><a href="/how-it-works" class="footer-link">How It Works</a></li>
          <li><a href="/portfolio" class="footer-link">Portfolio &amp; Samples</a></li>
          <li><a href="/about" class="footer-link">About AIPrintStudio</a></li>
          <li><a href="/contact" class="footer-link">Contact &amp; Free Quote</a></li>
          <li><a href="/privacy-policy" class="footer-link">Privacy Policy</a></li>
          <li><a href="/terms" class="footer-link">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="footer-bottom">
      <p class="footer-copyright">
        © {currentYear} AIPrintStudio.com. All rights reserved. 100% Human Quality Pre-Press Craftsmanship.
      </p>
      <div class="footer-badges">
        <span>✓ 300+ DPI Certified</span>
        <span>✓ CMYK Color Calibrated</span>
        <span>✓ Infinite Scalable Vector</span>
        <span>✓ 100% Print Shop Guarantee</span>
      </div>
      <p class="footer-credit">
        Designed & Developed by <a href="https://www.aiwebsiteservice.com/" target="_blank" rel="noopener noreferrer" class="footer-credit-link">AIWebsiteService</a>
      </p>
    </div>
  </div>
</footer>
