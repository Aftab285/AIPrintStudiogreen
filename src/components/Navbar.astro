---
interface Props {
  activePath?: string;
}

const { activePath = "/" } = Astro.props;

const whatsappUrl =
  "https://wa.me/923479429415?text=" +
  encodeURIComponent(
    "Hello! I created artwork using AI and need it professionally recreated into a commercial print-ready file. Can we discuss my project?"
  );
---

<nav class="navbar" id="site-navbar" role="navigation" aria-label="Main navigation">
  <div class="container">
    {/* Brand */}
    <a href="/" class="navbar__brand" aria-label="AIPrintStudio Homepage — Professional AI Artwork Recreation">
      <picture>
        <source srcset="/logo-80.webp" type="image/webp" />
        <img
          src="/logo.jpg"
          alt="AIPrintStudio Logo"
          width="40"
          height="40"
          class="navbar__logo"
          loading="eager"
          decoding="async"
        />
      </picture>
      <div class="navbar__brand-text">
        <span class="navbar__brand-name">AIPrintStudio</span>
        <span class="navbar__brand-tagline">
          Your AI Art, Perfect for Print.
        </span>
      </div>
    </a>

    {/* Desktop Navigation Links */}
    <ul class="navbar__links" id="navbar-links">
      <li>
        <a href="/" class={`navbar__link ${activePath === "/" ? "active" : ""}`} aria-label="AIPrintStudio Homepage">
          Home
        </a>
      </li>
      <li>
        <a href="/services" class={`navbar__link navbar__link--has-dropdown ${activePath.startsWith("/services") ? "active" : ""}`} aria-label="Commercial Pre-Press Print Services">
          Services
          <svg viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </li>
      <li>
        <a href="/how-it-works" class={`navbar__link ${activePath === "/how-it-works" ? "active" : ""}`} aria-label="How our 4-step artwork reproduction process works">
          How It Works
        </a>
      </li>
      <li>
        <a href="/portfolio" class={`navbar__link ${activePath === "/portfolio" ? "active" : ""}`} aria-label="Commercial pre-press portfolio and samples">
          Portfolio
        </a>
      </li>
      <li>
        <a href="/blog" class={`navbar__link ${activePath.startsWith("/blog") ? "active" : ""}`} aria-label="AI printing knowledge hub and tutorials">
          Blog
        </a>
      </li>
      <li>
        <a href="/about" class={`navbar__link ${activePath === "/about" ? "active" : ""}`} aria-label="About AIPrintStudio and our team">
          About
        </a>
      </li>
      <li>
        <a href="/contact" class={`navbar__link ${activePath === "/contact" ? "active" : ""}`} aria-label="Contact AIPrintStudio for a custom project quote">
          Contact
        </a>
      </li>
    </ul>

    {/* Actions */}
    <div class="navbar__actions">
      <a
        href="mailto:haftab285@gmail.com"
        class="navbar__email-link"
        aria-label="Send email to haftab285@gmail.com"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span>haftab285@gmail.com</span>
      </a>
      <a
        href={whatsappUrl}
        class="btn btn--primary"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat directly on WhatsApp with pre-press specialist"
      >
        <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
        </svg>
        Chat on WhatsApp
      </a>
      {/* Mobile Menu Toggle */}
      <button
        class="navbar__mobile-toggle"
        id="navbar-toggle"
        aria-label="Toggle mobile navigation menu"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<script>
  // Scroll header effect & mobile menu toggle
  const navbar = document.getElementById("site-navbar");
  const toggleBtn = document.getElementById("navbar-toggle");
  const navLinks = document.getElementById("navbar-links");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 10) {
      navbar?.classList.add("scrolled");
    } else {
      navbar?.classList.remove("scrolled");
    }
  }, { passive: true });

  toggleBtn?.addEventListener("click", () => {
    const expanded = toggleBtn.getAttribute("aria-expanded") === "true";
    toggleBtn.setAttribute("aria-expanded", String(!expanded));
    navLinks?.classList.toggle("mobile-open");
  });
</script>
